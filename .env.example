# Local backend
UNDERLEAF_HOST=127.0.0.1
UNDERLEAF_PORT=4317
UNDERLEAF_DATA_DIR=./data
UNDERLEAF_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://debeltoni.github.io
UNDERLEAF_PUBLIC_DISCOVERY_URL=https://debeltoni.github.io/UnderLeaf/api.json
UNDERLEAF_TRUST_PROXY=true

# Optional overrides
UNDERLEAF_SESSION_DAYS=30
UNDERLEAF_COMPILE_TIMEOUT_SECONDS=45
UNDERLEAF_DOCKER_IMAGE=underleaf-tectonic:0.16.9
UNDERLEAF_DOCKER_CONTAINER=underleaf-tectonic-worker
UNDERLEAF_FAKE_COMPILER=false
